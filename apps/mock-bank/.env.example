# apps/mock-bank — the simulated member banks.
# Copy to apps/mock-bank/.env. Every value below is a working local default.

# HTTP port the bank service listens on. Must match BANK_BASE_URL in apps/api.
BANK_PORT=3100

# The bank database — this is where customer money lives. Separate from the
# switch database on purpose: apps/api has no credentials for it.
BANK_DATABASE_URL=postgresql://caribpay:caribpay@localhost:5432/caribpay_bank

# Simulated processing time, so the switch's saga is exercised against a rail
# that does not answer instantly. Set both to 0 for fast tests.
MOCK_BANK_LATENCY_MIN_MS=300
MOCK_BANK_LATENCY_MAX_MS=1200

# Probability in [0,1] that a mutating call fails. Leave at 0 for a live demo;
# raise it to exercise the saga's refusal and recovery paths.
MOCK_BANK_FAILURE_RATE=0

# How long a hold survives without confirmation before the bank releases it,
# so a crashed transfer never strands a customer's funds.
MOCK_BANK_HOLD_TTL_SECONDS=300
