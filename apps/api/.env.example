# apps/api — the switch.
# Copy to apps/api/.env. Every value below is a working local default; the app
# falls back to these same values if the file is absent.

# HTTP port the switch listens on.
PORT=3000

# Switch database. Holds the directory, the clearing ledger and positions —
# never a customer balance. Matches docker-compose.yml.
DATABASE_URL=postgresql://caribpay:caribpay@localhost:5432/caribpay

# Redis, for the BullMQ transfer queue and the 60-second FX quote cache.
# Use 6380 here if 6379 is already taken on your machine (see the root .env.example).
REDIS_URL=redis://localhost:6379

# JWT access-token signing. Generate a real one with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# HMAC-SHA256 key for caribpay:// QR payloads. A payload with a bad signature is
# rejected, so this must match across every process that mints or resolves a QR.
QR_HMAC_SECRET=change-me-qr

# The member-bank service. The only route from the switch to a customer account;
# the switch has no credentials for the bank database.
BANK_BASE_URL=http://localhost:3100

# Past this, a bank's answer is unknown rather than failed — the saga re-sends
# the identical instruction instead of reversing. See BankUnknownError.
BANK_TIMEOUT_MS=10000

# Dev runs the transfer worker inside the API process. Set false when the worker
# runs as its own process (pm2 does this).
WORKER_IN_PROCESS=true
