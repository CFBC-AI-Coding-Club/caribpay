# Server
PORT=3000

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://caribpay:caribpay@localhost:5432/caribpay

# Redis (BullMQ queues + fx quote cache)
REDIS_URL=redis://localhost:6379

# Auth (generate real secrets with: openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# QR payload signing
QR_HMAC_SECRET=change-me-qr

# Mock CAPSS settlement provider
# Leave MOCK_SETTLEMENT_DELAY_MS empty for a realistic random 2-5 s delay;
# set a number (ms) to make settlement timing deterministic.
MOCK_SETTLEMENT_DELAY_MS=
MOCK_SETTLEMENT_FAILURES=false

# Set to false when the settlement worker runs as its own process (pm2)
WORKER_IN_PROCESS=true
